{
  "name": "surveyjs-performance-monitor",
  "private": true,
  "type": "module",
  "description": "The nightly performance server of survey-library: runs its perf suites, judges them against a baseline, bisects regressions and posts to Discord",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "vitest run",
    "lint": "eslint . --ext .ts,.js,.cjs --max-warnings=0",
    "lint:fix": "eslint . --ext .ts,.js,.cjs --max-warnings=0 --fix",
    "typecheck": "tsc -p .",
    "nightly": "node src/nightly.ts",
    "compare": "node src/judge/compare.ts",
    "baseline": "node src/judge/baseline.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "eslint": "^8.57.0",
    "typescript": "5.8.3",
    "vitest": "^2.1.9"
  }
}
